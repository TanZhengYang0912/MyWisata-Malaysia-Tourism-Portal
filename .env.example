# Supabase — get from https://supabase.com/dashboard/project/<project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed for server-side admin operations (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode flag — keeps mock payment/OTP/KYC enabled
NEXT_PUBLIC_DEMO_MODE=true

# ── Stripe (payout gateway) — get test keys from https://dashboard.stripe.com/test/apikeys ──
# Server-only secret. Never expose to client.
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
# Webhook signing secret from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
# Optional: pre-created Test Connected Account for demo payouts (see docs/STRIPE_SETUP.md)
STRIPE_DEMO_CONNECT_ACCOUNT=acct_YOUR_TEST_ACCOUNT
