# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# figma design reference screenshots (kept locally, not versioned)
scripts/figma-screenshots/

# local Git worktrees
.worktrees/

# local-only docs and agent instructions (not shared with the team)
/AGENTS.md
/CLAUDE.md
/docs/
AGENTS.md

# Lint / analysis output — never commit
lint-results.json
.superpowers/

# Ignore local assets and temp files
public/assets/
supabase/.temp/
scripts/__pycache__/
